# EcoAudit AI Backend Configuration
# Copy this file to .env and fill in the values

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_UPLOAD_SIZE_MB=20

